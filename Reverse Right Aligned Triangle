public class Pattern5 {

    public static void main(String[] args) {

        for (int i = 4; i >= 1; i--) {

            // Spaces
            for (int j = 1; j <= 4 - i; j++) {
                System.out.print(" ");
            }

            // Stars
            for (int k = 1; k <= i; k++) {
                System.out.print("*");
            }

            System.out.println();
        }
    }
}

