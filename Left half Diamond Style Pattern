public class Pattern6 {

    public static void main(String[] args) {

        // Upper part
        for (int i = 1; i <= 4; i++) {

            // Spaces
            for (int j = 1; j <= 4 - i; j++) {
                System.out.print(" ");
            }

            // Stars
            for (int k = 1; k <= i; k++) {
                System.out.print("*");
            }

            System.out.println();
        }

        // Lower part
        for (int i = 3; i >= 1; i--) {

            // Spaces
            for (int j = 1; j <= 4 - i; j++) {
                System.out.print(" ");
            }

            // Stars
            for (int k = 1; k <= i; k++) {
                System.out.print("*");
            }

            System.out.println();
        }
    }
}

